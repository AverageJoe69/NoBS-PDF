# NoBS PDF environment template — never put real credentials in this file.

# -----------------------------------------------------------------------------
# DEVELOPMENT / STRIPE TEST MODE
# -----------------------------------------------------------------------------
NODE_ENV=development
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
APP_BASE_URL=http://localhost:4173
HOST=127.0.0.1
PORT=4242
DATABASE_PATH=./data/nobs-development.sqlite
NOBS_RELEASE_VERSION=1.0.0
LICENCE_ACTIVATION_LIMIT=2
TRUST_PROXY_HOPS=0
MACOS_DOWNLOAD_URL=
WINDOWS_DOWNLOAD_URL=

# -----------------------------------------------------------------------------
# TEST / STAGING — use Stripe test objects and a deployed HTTPS staging origin.
# Set NODE_ENV=test and replace every value in the deployment secret manager.
# Use a persistent staging database path and HTTPS test download artifacts.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# PRODUCTION — example names only; values belong in the deployment secret manager.
# Production startup fails closed unless live Stripe, HTTPS, absolute persistent
# storage, both HTTPS downloads, and release 1.0.0 are explicitly configured.
# -----------------------------------------------------------------------------
# NODE_ENV=production
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=price_...
# APP_BASE_URL=https://nobspdf.com
# HOST=0.0.0.0
# PORT=4242
# DATABASE_PATH=/var/lib/nobspdf/nobs-production.sqlite
# NOBS_RELEASE_VERSION=1.0.0
# LICENCE_ACTIVATION_LIMIT=2
# TRUST_PROXY_HOPS=1
# MACOS_DOWNLOAD_URL=https://downloads.nobspdf.com/1.0.0/NoBS-PDF-1.0.0.dmg
# WINDOWS_DOWNLOAD_URL=https://downloads.nobspdf.com/1.0.0/NoBS-PDF-1.0.0-setup.exe
